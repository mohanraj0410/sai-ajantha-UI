# ==============================================================================
# Sai Ajantha Production Environment Configuration Template
# Copy this file to .env.production on your server and populate secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domains & SSL (used by Caddy gateway)
# ------------------------------------------------------------------------------
ACME_EMAIL=admin@sai-ajanta.com
STOREFRONT_DOMAIN=sai-ajanta.com
STOREFRONT_WWW_DOMAIN=www.sai-ajanta.com
ADMIN_DOMAIN=admin.sai-ajanta.com
API_DOMAIN=api.sai-ajanta.com

# ------------------------------------------------------------------------------
# 2. Database & Pooler Credentials
# ------------------------------------------------------------------------------
POSTGRES_USER=medusa
# Generate a strong password: openssl rand -base64 24
POSTGRES_PASSWORD=YourStrongDatabasePasswordHere
POSTGRES_DB=medusa

# ------------------------------------------------------------------------------
# 3. Cryptographic Secrets (MANDATORY FOR PRODUCTION)
# Generate each with: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_64_char_random_hex_string
COOKIE_SECRET=replace_with_64_char_random_hex_string
AUTH_MFA_ENCRYPTION_KEY=replace_with_64_char_random_hex_string

# ------------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
STORE_CORS=https://sai-ajanta.com,https://www.sai-ajanta.com
ADMIN_CORS=https://admin.sai-ajanta.com
AUTH_CORS=https://sai-ajanta.com,https://www.sai-ajanta.com,https://admin.sai-ajanta.com

# ------------------------------------------------------------------------------
# 5. Public URLs
# ------------------------------------------------------------------------------
MEDUSA_STATIC_URL=https://api.sai-ajanta.com/static
VITE_MEDUSA_BACKEND_URL=https://api.sai-ajanta.com
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.sai-ajanta.com
NEXT_PUBLIC_BASE_URL=https://sai-ajanta.com

# ------------------------------------------------------------------------------
# 6. Payment Gateway (Razorpay India B2B)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 7. Cloudflare R2 Object Storage (Images & Specification PDFs)
# ------------------------------------------------------------------------------
# Your Cloudflare Account ID (Cloudflare Dashboard > R2 > Overview > Account ID)
R2_ACCOUNT_ID=your_cloudflare_account_id
# R2 API Token credentials with Read & Write permissions
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Name of your R2 bucket
R2_BUCKET=sai-ajanta-media
# Optional custom R2 S3 endpoint (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com if empty)
R2_ENDPOINT=
# Public CDN URL for serving images (either R2 pub domain e.g. https://pub-xxxx.r2.dev or custom CDN domain e.g. https://media.sai-ajanta.com)
R2_PUBLIC_URL=https://pub-yourbucketid.r2.dev
NEXT_PUBLIC_R2_URL=https://pub-yourbucketid.r2.dev
R2_REGION=auto
